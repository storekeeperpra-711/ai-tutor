  "privacyTitle": "Privacy note",
  "@privacyTitle": {
    "description": "Title of the privacy note screen, and of the buttons that open it."
  },
  "privacyIntro": "This note says what AI Tutor keeps about your child, where it is kept, who can see it and for how long.",
  "@privacyIntro": {
    "description": "First paragraph of the privacy note."
  },
  "privacyKeptTitle": "What we keep",
  "@privacyKeptTitle": {
    "description": "Privacy note heading."
  },
  "privacyKept": "Your child's first name, class, picture and PIN (scrambled, so no one can read it), and their learning: lessons, answers, skills and badges. We never ask for a surname, an address, a phone number or a photo of your child.",
  "@privacyKept": {
    "description": "Privacy note paragraph: what is stored."
  },
  "privacyWhereTitle": "Where it is kept",
  "@privacyWhereTitle": {
    "description": "Privacy note heading."
  },
  "privacyWhere": "On this phone, and in your account on Google's Firebase servers, so that progress is safe if the phone is lost or changed.",
  "@privacyWhere": {
    "description": "Privacy note paragraph: where data is stored."
  },
  "privacyAiTitle": "Mithu's AI help",
  "@privacyAiTitle": {
    "description": "Privacy note heading."
  },
  "privacyAi": "When your child types an explanation, or takes a photo of their working, it is sent to Claude, an AI made by the company Anthropic, which writes Mithu's feedback. Your child's name is never sent. Phone numbers, emails and addresses are removed before sending. Photos are not kept after they are read. Anthropic's rules say it does not use this to train its AI. You can turn AI help off in Settings; the app then checks answers by itself.",
  "@privacyAi": {
    "description": "Privacy note paragraph: what goes to the AI. Claude and Anthropic are names."
  },
  "privacyWhoTitle": "Who can see it",
  "@privacyWhoTitle": {
    "description": "Privacy note heading."
  },
  "privacyWho": "You. A teacher, only if you join your child to their class: they see your child's first name and progress in that class. The app's small team can read AI messages, without names, to keep children safe and fix mistakes. No one else, and nothing is sold or used for adverts.",
  "@privacyWho": {
    "description": "Privacy note paragraph: who can see the data."
  },
  "privacyHowLongTitle": "How long it is kept",
  "@privacyHowLongTitle": {
    "description": "Privacy note heading."
  },
  "privacyHowLong": "Your child's profile and progress are kept until you delete them. AI messages are kept for 90 days for safety checks, then deleted. Daily counts of AI use (numbers only) are kept to watch costs.",
  "@privacyHowLong": {
    "description": "Privacy note paragraph: how long data is kept."
  },
  "privacySafetyTitle": "Keeping children safe",
  "@privacySafetyTitle": {
    "description": "Privacy note heading."
  },
  "privacySafety": "If your child writes something that suggests they are upset or unsafe, Mithu kindly asks them to talk to a parent or teacher they trust, and the message is marked for the team to read.",
  "@privacySafety": {
    "description": "Privacy note paragraph: what happens with worrying messages."
  },
  "privacyChoicesTitle": "Your choices",
  "@privacyChoicesTitle": {
    "description": "Privacy note heading."
  },
  "privacyChoices": "To remove a child and all their progress, tap the family button at the top of the home screen, then the bin next to the child. You can take a child out of a class at any time. You can turn AI help off in Settings.",
  "@privacyChoices": {
    "description": "Privacy note paragraph: deleting data and turning things off."
  },
