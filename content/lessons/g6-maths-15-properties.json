{
  "id": "g6-maths-15-properties",
  "version": 1,
  "schema": "0.2",
  "subject": "maths",
  "grade": 6,
  "tier": "middle",
  "curriculum_refs": [
    {
      "outcome": "Use the commutative, associative and distributive properties, and the rules for 0 and 1, to work out sums quickly.",
      "textbook": "Not a chapter of PCTB Mathematics 6 (SNC 2022) (revision unit): Whole Numbers"
    }
  ],
  "skills": [
    "maths.whole.properties"
  ],
  "title": {
    "en": "Properties of whole numbers",
    "ur": "مکمل اعداد کی خصوصیات"
  },
  "estimated_minutes": 15,
  "prerequisites": [
    {
      "skill": "maths.whole.compare"
    },
    {
      "skill": "maths.simplify.order_of_operations"
    }
  ],
  "misconceptions": [
    {
      "id": "swap_subtract",
      "description": "Thinks the order can be swapped in subtraction or division too."
    },
    {
      "id": "partial_distribute",
      "description": "Multiplies only the first number in the bracket: a × (b + c) = a × b + c."
    },
    {
      "id": "zero_one",
      "description": "Mixes up the rules for 0 and 1 (thinks a × 0 = a, or a + 0 = 0)."
    }
  ],
  "mastery_criteria": {
    "maths.whole.properties": {
      "question_types": [
        "recall",
        "apply",
        "find_error"
      ],
      "days": 2
    }
  },
  "question_bank": {
    "maths.whole.properties": [
      {
        "id": "qb_one",
        "type": "recall",
        "step": {
          "id": "qb_one",
          "type": "choice",
          "prompt": {
            "en": "Any whole number multiplied by 1 gives …",
            "ur": "کسی بھی مکمل عدد کو 1 سے ضرب دیں تو جواب …"
          },
          "options": [
            {
              "id": "same",
              "text": {
                "en": "the same number",
                "ur": "وہی عدد"
              },
              "correct": true,
              "feedback": {
                "en": "Yes! 1 doesn't change a number when you multiply.",
                "ur": "جی ہاں! ضرب میں 1 عدد کو نہیں بدلتا۔"
              }
            },
            {
              "id": "one",
              "text": {
                "en": "1",
                "ur": "1"
              },
              "correct": false,
              "feedback": {
                "en": "Only 1 × 1 = 1. For example 9 × 1 = 9.",
                "ur": "صرف 1 × 1 = 1۔ مثلاً 9 × 1 = 9"
              },
              "misconception_id": "zero_one"
            },
            {
              "id": "zero",
              "text": {
                "en": "0",
                "ur": "0"
              },
              "correct": false,
              "feedback": {
                "en": "That is × 0. × 1 keeps the number: 9 × 1 = 9.",
                "ur": "یہ × 0 ہے۔ × 1 عدد کو وہی رکھتا ہے: 9 × 1 = 9"
              },
              "misconception_id": "zero_one"
            }
          ]
        }
      },
      {
        "id": "qb_apply",
        "type": "apply",
        "step": {
          "id": "qb_apply",
          "type": "number",
          "prompt": {
            "en": "Work out 9 × 104 using 9 × 100 + 9 × 4.",
            "ur": "9 × 104 کو 9 × 100 + 9 × 4 سے حل کریں۔"
          },
          "answer": 936,
          "checker": "numeric",
          "hint": {
            "en": "900 + 36.",
            "ur": "900 + 36"
          },
          "feedback_correct": {
            "en": "Right! 936.",
            "ur": "درست! 936"
          },
          "feedback_wrong": {
            "en": "9 × 100 = 900, 9 × 4 = 36, 900 + 36 = 936.",
            "ur": "9 × 100 = 900، 9 × 4 = 36، 900 + 36 = 936"
          },
          "common_wrong": [
            {
              "answer": 904,
              "feedback": {
                "en": "Multiply the 4 by 9 too: 900 + 36 = 936.",
                "ur": "4 کو بھی 9 سے ضرب دیں: 900 + 36 = 936"
              },
              "misconception_id": "partial_distribute"
            }
          ]
        }
      },
      {
        "id": "qb_find_error",
        "type": "find_error",
        "step": {
          "id": "qb_find_error",
          "type": "choice",
          "prompt": {
            "en": "Hira says 12 ÷ 3 is the same as 3 ÷ 12. What is wrong?",
            "ur": "حرا کہتی ہے 12 ÷ 3 اور 3 ÷ 12 برابر ہیں۔ کیا غلطی ہے؟"
          },
          "options": [
            {
              "id": "order",
              "text": {
                "en": "Order matters in division: 12 ÷ 3 = 4, but 3 ÷ 12 is less than 1.",
                "ur": "تقسیم میں ترتیب اہم ہے: 12 ÷ 3 = 4، مگر 3 ÷ 12 ایک سے کم ہے۔"
              },
              "correct": true,
              "feedback": {
                "en": "Yes! Swapping works only for + and ×.",
                "ur": "جی ہاں! جگہ بدلنا صرف + اور × میں چلتا ہے۔"
              }
            },
            {
              "id": "nothing",
              "text": {
                "en": "Nothing.",
                "ur": "کوئی غلطی نہیں۔"
              },
              "correct": false,
              "feedback": {
                "en": "Sharing 12 among 3 is not sharing 3 among 12. Swapping works only for + and ×.",
                "ur": "12 کو 3 میں بانٹنا اور 3 کو 12 میں بانٹنا ایک نہیں۔ جگہ بدلنا صرف + اور × میں چلتا ہے۔"
              },
              "misconception_id": "swap_subtract"
            }
          ]
        }
      }
    ]
  },
  "flashcards": [
    {
      "id": "f_swap",
      "front": {
        "en": "a + b and a × b?",
        "ur": "a + b اور a × b؟"
      },
      "back": {
        "en": "Order doesn't matter: a + b = b + a, a × b = b × a.",
        "ur": "ترتیب سے فرق نہیں: a + b = b + a، a × b = b × a"
      }
    },
    {
      "id": "f_distribute",
      "front": {
        "en": "a × (b + c)?",
        "ur": "a × (b + c)؟"
      },
      "back": {
        "en": "a × b + a × c.",
        "ur": "a × b + a × c"
      }
    }
  ],
  "home_tasks": [
    {
      "id": "h_shop",
      "text": {
        "en": "At a shop, find something that costs Rs 99 or Rs 199. Work out the price of 5 of them in your head using 100 − 1 or 200 − 1.",
        "ur": "دکان پر کوئی چیز ڈھونڈیں جو 99 یا 199 روپے کی ہو۔ 100 − 1 یا 200 − 1 استعمال کرکے ذہن میں 5 کی قیمت نکالیں۔"
      }
    }
  ],
  "glossary": [
    {
      "en": "Commutative (order) property",
      "ur": "خاصیت مبادلہ"
    },
    {
      "en": "Associative (grouping) property",
      "ur": "خاصیت تلازم"
    },
    {
      "en": "Distributive property",
      "ur": "خاصیت تقسیم"
    }
  ],
  "steps": [
    {
      "id": "s1_hook",
      "type": "explain",
      "character": {
        "emotion": "curious",
        "say": {
          "en": "Can you work out 25 × 13 × 4 in your head? There's a trick!",
          "ur": "کیا آپ 25 × 13 × 4 ذہن میں نکال سکتے ہیں؟ اس کی ایک ترکیب ہے!"
        }
      },
      "text": {
        "en": "Today we learn the rules that let us swap, group and break up numbers to work faster. First, a quick brackets check.",
        "ur": "آج ہم وہ اصول سیکھیں گے جن سے ہم اعداد کی جگہ بدل کر، گروپ بنا کر اور توڑ کر جلدی حساب کر سکتے ہیں۔ پہلے قوسین کا ایک چھوٹا سا سوال۔"
      }
    },
    {
      "id": "s2_foundation",
      "type": "number",
      "question_type": "recall",
      "skill": "maths.simplify.order_of_operations",
      "prompt": {
        "en": "Simplify 4 × (5 + 3).",
        "ur": "4 × (5 + 3) مختصر کریں۔"
      },
      "answer": 32,
      "checker": "numeric",
      "hint": {
        "en": "Brackets first.",
        "ur": "پہلے قوسین۔"
      },
      "feedback_correct": {
        "en": "Right! 4 × 8 = 32.",
        "ur": "درست! 4 × 8 = 32"
      },
      "feedback_wrong": {
        "en": "5 + 3 = 8, then 4 × 8 = 32.",
        "ur": "5 + 3 = 8، پھر 4 × 8 = 32"
      },
      "common_wrong": [
        {
          "answer": 23,
          "feedback": {
            "en": "Do the brackets first: 4 × 8 = 32.",
            "ur": "پہلے قوسین: 4 × 8 = 32"
          }
        }
      ]
    },
    {
      "id": "s3_rule",
      "type": "explain",
      "character": {
        "emotion": "happy",
        "say": {
          "en": "Swap, group, break up. Three tricks for fast maths!",
          "ur": "جگہ بدلیں، گروپ بنائیں، توڑیں۔ تیز حساب کی تین ترکیبیں!"
        }
      },
      "text": {
        "en": "Order (commutative): a + b = b + a and a × b = b × a, but not for − or ÷. Grouping (associative): (a + b) + c = a + (b + c), and the same for ×. Breaking up (distributive): a × (b + c) = a × b + a × c. Also: a + 0 = a, a × 1 = a, and a × 0 = 0.",
        "ur": "ترتیب (مبادلہ): a + b = b + a اور a × b = b × a، مگر − اور ÷ میں نہیں۔ گروپ (تلازم): (a + b) + c = a + (b + c)، اور × میں بھی یہی۔ توڑنا (تقسیم): a × (b + c) = a × b + a × c۔ اور: a + 0 = a، a × 1 = a، اور a × 0 = 0"
      }
    },
    {
      "id": "s4_order",
      "type": "number",
      "question_type": "apply",
      "prompt": {
        "en": "Fill the gap: 37 + 58 = 58 + ?",
        "ur": "خالی جگہ پُر کریں: 37 + 58 = 58 + ؟"
      },
      "answer": 37,
      "checker": "numeric",
      "hint": {
        "en": "Swapping the order keeps the sum the same.",
        "ur": "ترتیب بدلنے سے مجموعہ وہی رہتا ہے۔"
      },
      "feedback_correct": {
        "en": "Right! 37.",
        "ur": "درست! 37"
      },
      "feedback_wrong": {
        "en": "37 + 58 = 58 + 37.",
        "ur": "37 + 58 = 58 + 37"
      },
      "common_wrong": [
        {
          "answer": 95,
          "feedback": {
            "en": "95 is the sum. The missing number is 37: 58 + 37.",
            "ur": "95 مجموعہ ہے۔ خالی جگہ پر 37: 58 + 37"
          }
        }
      ]
    },
    {
      "id": "s5_group",
      "type": "number",
      "question_type": "apply",
      "prompt": {
        "en": "Work out 25 × 13 × 4. (Hint: do 25 × 4 first.)",
        "ur": "25 × 13 × 4 نکالیں۔ (اشارہ: پہلے 25 × 4)"
      },
      "answer": 1300,
      "checker": "numeric",
      "hint": {
        "en": "25 × 4 = 100.",
        "ur": "25 × 4 = 100"
      },
      "feedback_correct": {
        "en": "Right! 100 × 13 = 1300.",
        "ur": "درست! 100 × 13 = 1300"
      },
      "feedback_wrong": {
        "en": "25 × 4 = 100, and 100 × 13 = 1300.",
        "ur": "25 × 4 = 100، اور 100 × 13 = 1300"
      },
      "common_wrong": [
        {
          "answer": 42,
          "feedback": {
            "en": "Multiply, don't add: 100 × 13 = 1300.",
            "ur": "جمع نہیں، ضرب: 100 × 13 = 1300"
          }
        }
      ]
    },
    {
      "id": "s6_not_true",
      "type": "choice",
      "prompt": {
        "en": "Which one is NOT true?",
        "ur": "کون سا درست نہیں ہے؟"
      },
      "options": [
        {
          "id": "subtract",
          "text": {
            "en": "9 − 4 = 4 − 9",
            "ur": "9 − 4 = 4 − 9"
          },
          "correct": true,
          "feedback": {
            "en": "Yes! 9 − 4 = 5, but 4 − 9 is not 5.",
            "ur": "جی ہاں! 9 − 4 = 5، مگر 4 − 9 پانچ نہیں ہے۔"
          }
        },
        {
          "id": "add",
          "text": {
            "en": "8 + 5 = 5 + 8",
            "ur": "8 + 5 = 5 + 8"
          },
          "correct": false,
          "feedback": {
            "en": "That is true: both are 13.",
            "ur": "یہ درست ہے: دونوں 13 ہیں۔"
          }
        },
        {
          "id": "times",
          "text": {
            "en": "6 × 7 = 7 × 6",
            "ur": "6 × 7 = 7 × 6"
          },
          "correct": false,
          "feedback": {
            "en": "That is true: both are 42.",
            "ur": "یہ درست ہے: دونوں 42 ہیں۔"
          }
        }
      ]
    },
    {
      "id": "s7_distribute",
      "type": "number",
      "question_type": "apply",
      "prompt": {
        "en": "Use 7 × 12 = 7 × 10 + 7 × 2. What is 7 × 12?",
        "ur": "7 × 12 = 7 × 10 + 7 × 2 استعمال کریں۔ 7 × 12 کتنا ہے؟"
      },
      "answer": 84,
      "checker": "numeric",
      "hint": {
        "en": "70 + 14.",
        "ur": "70 + 14"
      },
      "feedback_correct": {
        "en": "Right! 84.",
        "ur": "درست! 84"
      },
      "feedback_wrong": {
        "en": "7 × 10 = 70, 7 × 2 = 14, 70 + 14 = 84.",
        "ur": "7 × 10 = 70، 7 × 2 = 14، 70 + 14 = 84"
      },
      "common_wrong": [
        {
          "answer": 72,
          "feedback": {
            "en": "Multiply the 2 by 7 as well: 70 + 14 = 84.",
            "ur": "2 کو بھی 7 سے ضرب دیں: 70 + 14 = 84"
          },
          "misconception_id": "partial_distribute"
        }
      ]
    },
    {
      "id": "s8_zero",
      "type": "number",
      "question_type": "apply",
      "prompt": {
        "en": "What is 4589 × 0?",
        "ur": "4589 × 0 کتنا ہے؟"
      },
      "answer": 0,
      "checker": "numeric",
      "hint": {
        "en": "Anything times 0 is …",
        "ur": "کسی بھی عدد کو 0 سے ضرب دیں تو …"
      },
      "feedback_correct": {
        "en": "Right! 0.",
        "ur": "درست! 0"
      },
      "feedback_wrong": {
        "en": "Any number × 0 = 0: 4589 zeros make 0.",
        "ur": "کوئی بھی عدد × 0 = 0: 4589 صفر مل کر 0"
      },
      "common_wrong": [
        {
          "answer": 4589,
          "feedback": {
            "en": "That is × 1. Any number × 0 = 0.",
            "ur": "یہ × 1 ہے۔ کوئی بھی عدد × 0 = 0"
          },
          "misconception_id": "zero_one"
        }
      ]
    },
    {
      "id": "s9_find_error",
      "type": "choice",
      "question_type": "find_error",
      "prompt": {
        "en": "Ali says 5 × (8 + 2) = 5 × 8 + 2 = 42. What went wrong?",
        "ur": "علی کہتا ہے 5 × (8 + 2) = 5 × 8 + 2 = 42۔ کیا غلطی ہوئی؟"
      },
      "options": [
        {
          "id": "both",
          "text": {
            "en": "Multiply both numbers: 5 × 8 + 5 × 2 = 50.",
            "ur": "دونوں اعداد کو ضرب دیں: 5 × 8 + 5 × 2 = 50"
          },
          "correct": true,
          "feedback": {
            "en": "Yes! The 5 multiplies everything in the bracket.",
            "ur": "جی ہاں! 5 قوسین کی ہر چیز کو ضرب دیتا ہے۔"
          }
        },
        {
          "id": "add",
          "text": {
            "en": "He should add: 5 + 8 + 2 = 15.",
            "ur": "اسے جمع کرنا چاہیے: 5 + 8 + 2 = 15"
          },
          "correct": false,
          "feedback": {
            "en": "It is ×, not +. 5 × 8 + 5 × 2 = 50.",
            "ur": "یہ × ہے، + نہیں۔ 5 × 8 + 5 × 2 = 50"
          }
        },
        {
          "id": "nothing",
          "text": {
            "en": "Nothing.",
            "ur": "کوئی غلطی نہیں۔"
          },
          "correct": false,
          "feedback": {
            "en": "5 × 10 = 50, not 42. He forgot 5 × 2.",
            "ur": "5 × 10 = 50، 42 نہیں۔ وہ 5 × 2 بھول گیا۔"
          },
          "misconception_id": "partial_distribute"
        }
      ]
    },
    {
      "id": "s10_explain_why",
      "type": "ai_explain",
      "question_type": "explain",
      "task_kind": "explain",
      "character": {
        "emotion": "curious",
        "say": {
          "en": "Why is 3 × 5 the same as 5 × 3? Can you teach me?",
          "ur": "3 × 5 اور 5 × 3 برابر کیوں ہیں؟ کیا آپ مجھے سکھا سکتے ہیں؟"
        }
      },
      "task": {
        "en": "In your own words: why does 3 × 5 = 5 × 3? You can think of chairs in rows.",
        "ur": "اپنے الفاظ میں بتائیں: 3 × 5 = 5 × 3 کیوں ہے؟ آپ قطاروں میں کرسیوں کا سوچ سکتے ہیں۔"
      },
      "key_idea": "3 rows of 5 chairs is the same set of chairs as 5 columns of 3 when you look from the side, so both are 15. Turning the rectangle doesn't change how many there are.",
      "levels": {
        "got_it": "Uses rows and columns (or groups) to show both give 15, so order doesn't matter.",
        "partly": "Says both are 15 without a reason.",
        "not_yet": "Gives no reason."
      },
      "keywords": [
        [
          "row",
          "column",
          "قطار",
          "کالم"
        ],
        [
          "15",
          "fifteen",
          "پندرہ"
        ],
        [
          "group",
          "گروپ"
        ]
      ],
      "fallback_feedback": {
        "got_it": {
          "en": "Well explained! Turning the rows doesn't change the total.",
          "ur": "بہت خوب! قطاریں گھمانے سے کل نہیں بدلتا۔"
        },
        "partly": {
          "en": "Good start! Now explain it with rows and columns.",
          "ur": "اچھی شروعات! اب قطاروں اور کالموں سے سمجھائیں۔"
        },
        "not_yet": {
          "en": "Draw 3 rows of 5 dots. Now count them in columns. What do you see?",
          "ur": "5 نقطوں کی 3 قطاریں بنائیں۔ اب انہیں کالموں میں گنیں۔ آپ کیا دیکھتے ہیں؟"
        }
      },
      "limit_per_day": 3,
      "max_attempts": 2
    },
    {
      "id": "s11_biscuits",
      "type": "number",
      "question_type": "apply",
      "prompt": {
        "en": "A shop sells 8 packs of 25 biscuits and 8 packs of 15 biscuits. How many biscuits is that? (8 × (25 + 15))",
        "ur": "ایک دکان 25 بسکٹ والے 8 پیکٹ اور 15 بسکٹ والے 8 پیکٹ بیچتی ہے۔ کل کتنے بسکٹ ہیں؟ (8 × (25 + 15))"
      },
      "answer": 320,
