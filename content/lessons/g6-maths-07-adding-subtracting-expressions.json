  "question_bank": {
    "maths.algebra.add_subtract": [
      {
        "id": "qb_rule",
        "type": "recall",
        "step": {
          "id": "qb_rule",
          "type": "choice",
          "prompt": {
            "en": "To take away (3a + 4), you …",
            "ur": "(3a + 4) تفریق کرنے کے لیے آپ …"
          },
          "options": [
            {
              "id": "both",
              "text": {
                "en": "take away 3a AND take away 4",
                "ur": "3a بھی تفریق کریں اور 4 بھی"
              },
              "correct": true,
              "feedback": {
                "en": "Yes! −(3a + 4) = −3a − 4.",
                "ur": "جی ہاں! −(3a + 4) = −3a − 4"
              }
            },
            {
              "id": "first",
              "text": {
                "en": "take away 3a and add 4",
                "ur": "3a تفریق کریں اور 4 جمع کریں"
              },
              "correct": false,
              "feedback": {
                "en": "The whole bracket is taken away, so 4 is taken away too: −3a − 4.",
                "ur": "پوری بریکٹ تفریق ہوتی ہے، تو 4 بھی تفریق: −3a − 4"
              },
              "misconception_id": "first_term_only"
            },
            {
              "id": "ignore",
              "text": {
                "en": "just drop the bracket",
                "ur": "بس بریکٹ ہٹا دیں"
              },
              "correct": false,
              "feedback": {
                "en": "The minus in front changes every sign inside: −3a − 4.",
                "ur": "سامنے کا منفی اندر کی ہر علامت بدلتا ہے: −3a − 4"
              },
              "misconception_id": "first_term_only"
            }
          ]
        }
      },
      {
        "id": "qb_apply",
        "type": "apply",
        "step": {
          "id": "qb_apply",
          "type": "text_check",
          "prompt": {
            "en": "Simplify (9k + 7) − (4k + 2).",
            "ur": "(9k + 7) − (4k + 2) کو مختصر کریں۔"
