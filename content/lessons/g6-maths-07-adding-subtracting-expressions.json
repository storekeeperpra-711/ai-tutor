          "hint": {
            "en": "Take away 4k AND take away 2.",
            "ur": "4k بھی تفریق کریں اور 2 بھی۔"
          },
          "feedback_correct": {
            "en": "Right! 5k + 5.",
            "ur": "درست! 5k + 5"
          },
          "feedback_wrong": {
            "en": "9k − 4k = 5k and 7 − 2 = 5: 5k + 5.",
            "ur": "9k − 4k = 5k اور 7 − 2 = 5: 5k + 5"
          },
          "common_wrong": [
            {
              "answer": "5k + 9",
              "feedback": {
                "en": "Take away the 2 as well: 7 − 2 = 5. 5k + 5.",
                "ur": "2 بھی تفریق کریں: 7 − 2 = 5۔ 5k + 5"
              },
              "misconception_id": "first_term_only"
            }
          ]
        }
      },
      {
        "id": "qb_find_error",
        "type": "find_error",
        "step": {
          "id": "qb_find_error",
          "type": "choice",
          "prompt": {
            "en": "Hamza writes (2a + b) + (3a + 4b) = 5a + 4b. What is wrong?",
            "ur": "حمزہ لکھتا ہے (2a + b) + (3a + 4b) = 5a + 4b۔ کیا غلطی ہے؟"
          },
          "options": [
            {
              "id": "one_b",
              "text": {
                "en": "b means 1b, so b + 4b = 5b: the answer is 5a + 5b.",
                "ur": "b یعنی 1b، تو b + 4b = 5b: جواب 5a + 5b"
              },
              "correct": true,
              "feedback": {
                "en": "Yes! Don't lose the lone b.",
                "ur": "جی ہاں! اکیلا b نہ کھوئیں۔"
              }
            },
            {
              "id": "nothing",
              "text": {
                "en": "Nothing.",
                "ur": "کوئی غلطی نہیں۔"
              },
              "correct": false,
              "feedback": {
                "en": "He left out the first b. b + 4b = 5b: 5a + 5b.",
                "ur": "اس نے پہلا b چھوڑ دیا۔ b + 4b = 5b: 5a + 5b"
              },
              "misconception_id": "lone_letter_zero"
            },
            {
              "id": "all",
              "text": {
                "en": "It should be 10ab.",
                "ur": "یہ 10ab ہونا چاہیے۔"
              },
              "correct": false,
              "feedback": {
                "en": "a and b are unlike terms; they stay apart: 5a + 5b.",
                "ur": "a اور b غیر یکساں ارکان ہیں؛ الگ رہتے ہیں: 5a + 5b"
              },
              "misconception_id": "unlike_joined"
            }
          ]
        }
      }
    ]
  },
