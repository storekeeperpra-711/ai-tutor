  "misconceptions": [
    {
      "id": "first_term_only",
      "description": "When subtracting a bracket, changes the sign of only the first term inside it."
    },
    {
      "id": "unlike_joined",
      "description": "Adds unlike terms together (5x + 6 becomes 11x)."
    },
    {
      "id": "lone_letter_zero",
      "description": "Forgets that a lone letter (a) means 1a when collecting."
    }
  ],
  "mastery_criteria": {
