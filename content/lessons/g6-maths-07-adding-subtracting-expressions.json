        {
          "id": "first_only",
          "text": {
            "en": "4m + 8",
            "ur": "4m + 8"
          },
          "correct": false,
          "feedback": {
            "en": "The 3 must be taken away too: 5 − 3 = 2. 4m + 2.",
            "ur": "3 بھی تفریق کرنا ہے: 5 − 3 = 2۔ 4m + 2"
          },
          "misconception_id": "first_term_only"
        },
        {
          "id": "added",
          "text": {
            "en": "8m + 2",
            "ur": "8m + 2"
          },
          "correct": false,
          "feedback": {
            "en": "Take away 2m, don't add it: 6m − 2m = 4m.",
            "ur": "2m تفریق کریں، جمع نہیں: 6m − 2m = 4m"
          }
        }
      ]
    },
    {
      "id": "s7_subtract",
      "type": "text_check",
      "question_type": "apply",
      "prompt": {
        "en": "Simplify (7y + 9) − (3y + 4).",
        "ur": "(7y + 9) − (3y + 4) کو مختصر کریں۔"
