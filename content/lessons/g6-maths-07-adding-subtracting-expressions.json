  "steps": [
    {
      "id": "s1_hook",
      "type": "explain",
      "character": {
        "emotion": "curious",
        "say": {
          "en": "A basket has 6 mangoes and 5 bananas. Take out 2 mangoes and 3 bananas. Can algebra keep track?",
          "ur": "ٹوکری میں 6 آم اور 5 کیلے ہیں۔ 2 آم اور 3 کیلے نکالیں۔ کیا الجبرا حساب رکھ سکتا ہے؟"
        }
      },
      "text": {
        "en": "Today we add and subtract whole expressions, with brackets. First, collect like terms.",
        "ur": "آج ہم بریکٹ والی پوری عبارتیں جمع اور تفریق کریں گے۔ پہلے یکساں ارکان جمع کریں۔"
      }
    },
    {
      "id": "s2_foundation",
      "type": "text_check",
      "question_type": "recall",
      "skill": "maths.algebra.expressions_basic",
      "prompt": {
        "en": "Simplify 3a + 2a.",
        "ur": "3a + 2a کو مختصر کریں۔"
      },
      "checker": "text",
      "expected": "5a",
      "hint": {
        "en": "3 a's and 2 more a's.",
        "ur": "3 a اور 2 مزید a"
      },
      "feedback_correct": {
        "en": "Right! 5a.",
        "ur": "درست! 5a"
      },
      "feedback_wrong": {
        "en": "3a + 2a = 5a, like 3 apples + 2 apples.",
        "ur": "3a + 2a = 5a، جیسے 3 سیب + 2 سیب"
      },
      "common_wrong": [
        {
          "answer": "6a",
          "feedback": {
            "en": "Add the coefficients, don't multiply: 3 + 2 = 5. 5a.",
            "ur": "عددی سر جمع کریں، ضرب نہیں: 3 + 2 = 5۔ 5a"
          }
        }
      ]
    },
    {
      "id": "s3_rule",
      "type": "explain",
      "character": {
        "emotion": "happy",
        "say": {
          "en": "Adding? Just collect like terms. Subtracting? Change every sign in the bracket first!",
          "ur": "جمع؟ بس یکساں ارکان جمع کریں۔ تفریق؟ پہلے بریکٹ کی ہر علامت بدلیں!"
        }
      },
      "text": {
        "en": "To add expressions, remove the brackets and collect like terms: (3a + 2b) + (4a + b) = 3a + 2b + 4a + b = 7a + 3b. To subtract, the minus sign takes away EVERYTHING in the bracket, so every sign inside changes: (5x + 4) − (2x + 1) = 5x + 4 − 2x − 1 = 3x + 3. Unlike terms, like 3x and 3, stay apart.",
        "ur": "عبارتیں جمع کرنے کے لیے بریکٹ ہٹائیں اور یکساں ارکان جمع کریں: (3a + 2b) + (4a + b) = 3a + 2b + 4a + b = 7a + 3b۔ تفریق میں منفی کی علامت بریکٹ کی ہر چیز تفریق کرتی ہے، تو اندر کی ہر علامت بدل جاتی ہے: (5x + 4) − (2x + 1) = 5x + 4 − 2x − 1 = 3x + 3۔ غیر یکساں ارکان، جیسے 3x اور 3، الگ رہتے ہیں۔"
      }
    },
    {
      "id": "s4_add",
      "type": "text_check",
      "question_type": "apply",
      "prompt": {
        "en": "Simplify (2x + 5) + (3x + 1).",
        "ur": "(2x + 5) + (3x + 1) کو مختصر کریں۔"
      },
      "checker": "text",
      "expected": "5x + 6",
      "accept": [
        "6+5x"
      ],
      "hint": {
        "en": "x terms together, numbers together.",
        "ur": "x والے ارکان اکٹھے، اعداد اکٹھے۔"
      },
      "feedback_correct": {
        "en": "Right! 5x + 6.",
        "ur": "درست! 5x + 6"
      },
      "feedback_wrong": {
        "en": "2x + 3x = 5x and 5 + 1 = 6: 5x + 6.",
        "ur": "2x + 3x = 5x اور 5 + 1 = 6: 5x + 6"
      },
      "common_wrong": [
        {
          "answer": "11x",
          "feedback": {
            "en": "5x and 6 are unlike terms; they stay apart: 5x + 6.",
            "ur": "5x اور 6 غیر یکساں ہیں؛ الگ رہتے ہیں: 5x + 6"
          },
          "misconception_id": "unlike_joined"
        }
      ]
    },
    {
      "id": "s5_add_two",
      "type": "text_check",
      "question_type": "apply",
      "prompt": {
        "en": "Simplify (4a + 3b) + (a − b).",
        "ur": "(4a + 3b) + (a − b) کو مختصر کریں۔"
      },
      "checker": "text",
      "expected": "5a + 2b",
      "accept": [
        "2b+5a"
      ],
      "hint": {
        "en": "a means 1a, and −b means −1b.",
        "ur": "a یعنی 1a، اور −b یعنی −1b"
      },
      "feedback_correct": {
        "en": "Right! 5a + 2b.",
        "ur": "درست! 5a + 2b"
      },
      "feedback_wrong": {
        "en": "4a + a = 5a and 3b − b = 2b: 5a + 2b.",
        "ur": "4a + a = 5a اور 3b − b = 2b: 5a + 2b"
      },
      "common_wrong": [
        {
          "answer": "4a + 2b",
          "feedback": {
            "en": "Don't lose the lone a: 4a + a = 5a. 5a + 2b.",
            "ur": "اکیلا a نہ کھوئیں: 4a + a = 5a۔ 5a + 2b"
          },
          "misconception_id": "lone_letter_zero"
        }
      ]
    },
    {
      "id": "s6_subtract",
      "type": "choice",
      "prompt": {
        "en": "What is (6m + 5) − (2m + 3)?",
        "ur": "(6m + 5) − (2m + 3) کیا ہے؟"
      },
      "options": [
        {
