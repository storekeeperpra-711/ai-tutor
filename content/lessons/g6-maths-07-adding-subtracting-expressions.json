    {
      "id": "s10_explain_why",
      "type": "ai_explain",
      "question_type": "explain",
      "task_kind": "explain",
      "character": {
        "emotion": "curious",
        "say": {
          "en": "Why does −(2x + 1) turn the + 1 into − 1? It wasn't next to the minus! Help me.",
          "ur": "−(2x + 1) میں + 1، − 1 کیوں بن جاتا ہے؟ یہ تو منفی کے ساتھ نہیں تھا! میری مدد کریں۔"
        }
      },
      "task": {
        "en": "Explain why (5x + 4) − (2x + 1) is 3x + 3 and not 3x + 5.",
        "ur": "بتائیں کہ (5x + 4) − (2x + 1) کا جواب 3x + 3 کیوں ہے، 3x + 5 کیوں نہیں۔"
      },
      "key_idea": "The minus sign takes away the whole bracket, both 2x and 1. So −(2x + 1) = −2x − 1. Then 5x − 2x = 3x and 4 − 1 = 3, giving 3x + 3. 3x + 5 comes from taking away only 2x and adding the 1.",
      "levels": {
        "got_it": "Says the whole bracket is taken away (−2x − 1), so 4 − 1 = 3, giving 3x + 3.",
        "partly": "Gets 3x + 3 but doesn't say why the 1 is subtracted.",
        "not_yet": "Gives no reason."
      },
      "keywords": [
        [
          "whole",
          "both",
          "everything",
          "پوری",
          "دونوں"
        ],
        [
          "-1",
          "− 1",
          "minus 1",
          "take away 1",
          "1 تفریق"
        ],
        [
          "3x + 3",
          "3x+3"
        ],
        [
          "bracket",
          "بریکٹ"
        ]
      ],
      "fallback_feedback": {
        "got_it": {
          "en": "Well explained! The whole bracket goes, so − 1.",
          "ur": "بہت خوب! پوری بریکٹ تفریق، تو − 1"
        },
        "partly": {
          "en": "Good start! Why is the 1 taken away and not added?",
          "ur": "اچھی شروعات! 1 تفریق کیوں ہوتا ہے، جمع کیوں نہیں؟"
        },
