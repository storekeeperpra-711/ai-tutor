  "question_bank": {
    "maths.simplify.fractions_decimals": [
      {
        "id": "qb_of",
        "type": "recall",
        "step": {
          "id": "qb_of",
          "type": "choice",
          "prompt": {
            "en": "What does 'of' mean in '1/2 of 10'?",
            "ur": "'10 کا 1/2' میں 'کا' کا کیا مطلب ہے؟"
          },
          "options": [
            {
              "id": "times",
              "text": {
                "en": "Multiply: 1/2 × 10",
                "ur": "ضرب: 1/2 × 10"
              },
              "correct": true,
              "feedback": {
                "en": "Yes! 1/2 of 10 = 1/2 × 10 = 5.",
                "ur": "جی ہاں! 10 کا 1/2 = 1/2 × 10 = 5"
              }
            },
            {
              "id": "plus",
              "text": {
                "en": "Add: 1/2 + 10",
                "ur": "جمع: 1/2 + 10"
              },
              "correct": false,
              "feedback": {
                "en": "'Of' means multiply: 1/2 × 10 = 5.",
                "ur": "'کا' کا مطلب ضرب ہے: 1/2 × 10 = 5"
              }
            },
            {
              "id": "divide",
              "text": {
                "en": "Divide: 1/2 ÷ 10",
                "ur": "تقسیم: 1/2 ÷ 10"
              },
              "correct": false,
              "feedback": {
                "en": "'Of' means multiply: half of 10 is 5.",
                "ur": "'کا' کا مطلب ضرب ہے: 10 کا آدھا 5 ہے۔"
              }
            }
          ]
        }
      },
      {
        "id": "qb_apply",
        "type": "apply",
        "step": {
          "id": "qb_apply",
          "type": "number",
          "prompt": {
            "en": "Simplify: 4.5 − 0.5 × 3",
            "ur": "مختصر کریں: 4.5 − 0.5 × 3"
          },
          "answer": 3,
          "checker": "numeric",
          "hint": {
            "en": "Do 0.5 × 3 first.",
            "ur": "پہلے 0.5 × 3 کریں۔"
          },
          "feedback_correct": {
            "en": "Right! 4.5 − 1.5 = 3.",
            "ur": "درست! 4.5 − 1.5 = 3"
          },
          "feedback_wrong": {
            "en": "0.5 × 3 = 1.5, then 4.5 − 1.5 = 3.",
            "ur": "0.5 × 3 = 1.5، پھر 4.5 − 1.5 = 3"
          },
          "common_wrong": [
            {
              "answer": 12,
              "feedback": {
                "en": "That subtracts first. Multiply first: 4.5 − 1.5 = 3.",
                "ur": "یہ پہلے تفریق ہے۔ پہلے ضرب: 4.5 − 1.5 = 3"
              },
              "misconception_id": "left_to_right_all"
            }
          ]
        }
      },
      {
        "id": "qb_find_error",
        "type": "find_error",
        "step": {
          "id": "qb_find_error",
          "type": "choice",
          "prompt": {
            "en": "Rida writes 1/2 of (10 + 6) = 5 + 6 = 11. What is wrong?",
            "ur": "ردا لکھتی ہے: (10 + 6) کا 1/2 = 5 + 6 = 11۔ کیا غلطی ہے؟"
          },
          "options": [
            {
              "id": "bracket",
              "text": {
                "en": "She should add first: 1/2 of 16 = 8.",
                "ur": "اسے پہلے جمع کرنا چاہیے: 16 کا 1/2 = 8"
              },
              "correct": true,
              "feedback": {
                "en": "Yes! 'Of' applies to the whole bracket.",
                "ur": "جی ہاں! 'کا' پوری قوسین پر لگتا ہے۔"
              }
            },
            {
              "id": "nothing",
              "text": {
                "en": "Nothing.",
                "ur": "کوئی غلطی نہیں۔"
              },
              "correct": false,
              "feedback": {
                "en": "She halved only the 10. Half of the whole 16 is 8.",
                "ur": "اس نے صرف 10 کا آدھا لیا۔ پورے 16 کا آدھا 8 ہے۔"
              },
              "misconception_id": "of_only_first"
            }
          ]
        }
      }
    ]
  },
