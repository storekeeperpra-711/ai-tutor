      "answer": 4,
      "checker": "numeric",
      "hint": {
        "en": "0.5 is half.",
        "ur": "0.5 یعنی آدھا۔"
      },
      "feedback_correct": {
        "en": "Right! 4.",
        "ur": "درست! 4"
      },
      "feedback_wrong": {
