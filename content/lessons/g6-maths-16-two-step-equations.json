  "question_bank": {
    "maths.equations.two_step": [
      {
        "id": "qb_first",
        "type": "recall",
        "step": {
          "id": "qb_first",
          "type": "choice",
          "prompt": {
            "en": "To solve 3x + 2 = 14, what do you do first?",
            "ur": "3x + 2 = 14 حل کرنے کے لیے پہلے کیا کریں گے؟"
          },
          "options": [
            {
              "id": "subtract",
              "text": {
                "en": "Subtract 2 from both sides",
                "ur": "دونوں طرف سے 2 تفریق"
              },
              "correct": true,
              "feedback": {
                "en": "Yes! 3x = 12, then x = 4.",
                "ur": "جی ہاں! 3x = 12، پھر x = 4"
              }
            },
            {
              "id": "divide",
              "text": {
                "en": "Divide both sides by 3",
                "ur": "دونوں طرف کو 3 سے تقسیم"
              },
              "correct": false,
              "feedback": {
                "en": "Undo the + 2 first, then the × 3.",
                "ur": "پہلے + 2 ختم کریں، پھر × 3"
              },
              "misconception_id": "divide_first"
            },
            {
              "id": "add",
              "text": {
                "en": "Add 2 to both sides",
                "ur": "دونوں طرف 2 جمع"
              },
              "correct": false,
              "feedback": {
                "en": "Undo + 2 by subtracting 2, not adding.",
                "ur": "+ 2 کو 2 تفریق کرکے ختم کریں، جمع کرکے نہیں۔"
              },
              "misconception_id": "wrong_inverse"
            }
          ]
        }
      },
      {
        "id": "qb_apply",
        "type": "apply",
        "step": {
          "id": "qb_apply",
          "type": "number",
          "prompt": {
            "en": "Solve 6k + 3 = 45. What is k?",
            "ur": "6k + 3 = 45 حل کریں۔ k کیا ہے؟"
          },
          "answer": 7,
          "checker": "numeric",
          "hint": {
            "en": "Subtract 3, then divide by 6.",
            "ur": "3 تفریق کریں، پھر 6 سے تقسیم۔"
          },
          "feedback_correct": {
            "en": "Right! k = 7.",
            "ur": "درست! k = 7"
          },
          "feedback_wrong": {
            "en": "45 − 3 = 42, then 42 ÷ 6 = 7.",
            "ur": "45 − 3 = 42، پھر 42 ÷ 6 = 7"
          },
          "common_wrong": [
            {
              "answer": 8,
              "feedback": {
                "en": "Undo + 3 by subtracting: 42 ÷ 6 = 7.",
                "ur": "+ 3 کو تفریق سے ختم کریں: 42 ÷ 6 = 7"
              },
              "misconception_id": "wrong_inverse"
            },
            {
              "answer": 42,
              "feedback": {
                "en": "That is 6k. Divide by 6: k = 7.",
                "ur": "یہ 6k ہے۔ 6 سے تقسیم کریں: k = 7"
              },
              "misconception_id": "one_step_only"
            }
          ]
        }
      },
      {
        "id": "qb_find_error",
        "type": "find_error",
        "step": {
          "id": "qb_find_error",
          "type": "choice",
          "prompt": {
            "en": "Sana solves 5x − 2 = 18. She writes 5x = 16, so x = 3.2. What is wrong?",
            "ur": "ثنا 5x − 2 = 18 حل کرتی ہے۔ وہ لکھتی ہے 5x = 16، تو x = 3.2۔ کیا غلطی ہے؟"
          },
          "options": [
            {
              "id": "add",
              "text": {
                "en": "Undo − 2 by adding 2: 5x = 20, x = 4.",
                "ur": "− 2 کو 2 جمع کرکے ختم کریں: 5x = 20، x = 4"
              },
              "correct": true,
              "feedback": {
                "en": "Yes! Check: 5 × 4 − 2 = 18.",
                "ur": "جی ہاں! جانچ: 5 × 4 − 2 = 18"
              }
            },
            {
              "id": "nothing",
              "text": {
                "en": "Nothing.",
                "ur": "کوئی غلطی نہیں۔"
              },
              "correct": false,
              "feedback": {
                "en": "Check: 5 × 3.2 − 2 = 14, not 18. Add 2 first: 5x = 20, x = 4.",
                "ur": "جانچ: 5 × 3.2 − 2 = 14، 18 نہیں۔ پہلے 2 جمع کریں: 5x = 20، x = 4"
              },
              "misconception_id": "wrong_inverse"
            }
          ]
        }
      }
    ]
