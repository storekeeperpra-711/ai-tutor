  "misconceptions": [
    {
      "id": "divide_first",
      "description": "Divides before undoing the + or −, or divides only one term."
    },
    {
      "id": "one_step_only",
      "description": "Stops after the first step and forgets to undo the × or ÷."
    },
    {
      "id": "wrong_inverse",
      "description": "Undoes + by adding, or ÷ by dividing."
    }
  ],
