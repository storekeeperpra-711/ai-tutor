          },
          "misconception_id": "percent_is_decimal"
        },
        {
          "answer": 2.5,
          "feedback": {
            "en": "That divides by 10. Divide by 100: 0.25.",
            "ur": "یہ 10 سے تقسیم ہے۔ 100 سے تقسیم کریں: 0.25"
          },
          "misconception_id": "one_place"
        }
      ]
    },
    {
      "id": "s6_frac_to_pc",
      "type": "number",
      "question_type": "apply",
      "prompt": {
        "en": "Write 3/4 as a percent. Type just the number.",
        "ur": "3/4 کو فیصد میں لکھیں۔ صرف عدد لکھیں۔"
      },
      "answer": 75,
      "checker": "numeric",
      "hint": {
        "en": "3/4 = ?/100. Multiply top and bottom by 25.",
        "ur": "3/4 = ?/100۔ اوپر اور نیچے کو 25 سے ضرب دیں۔"
      },
      "feedback_correct": {
        "en": "Right! 3/4 = 75%.",
        "ur": "درست! 3/4 = 75%"
      },
      "feedback_wrong": {
        "en": "3/4 = 75/100 = 75%.",
        "ur": "3/4 = 75/100 = 75%"
      },
      "common_wrong": [
        {
          "answer": 34,
          "feedback": {
            "en": "3/4 is not 34%. Make the bottom 100: 75/100 = 75%.",
            "ur": "3/4، 34% نہیں ہے۔ نیچے والا 100 بنائیں: 75/100 = 75%"
          }
        },
        {
          "answer": 25,
          "feedback": {
            "en": "25% is 1/4. Three quarters is 3 × 25 = 75%.",
            "ur": "25% یعنی 1/4۔ تین چوتھائی 3 × 25 = 75% ہے۔"
          }
        }
      ]
    },
    {
      "id": "s7_pc_to_frac",
      "type": "choice",
      "prompt": {
        "en": "Write 40% as a fraction in its simplest form.",
        "ur": "40% کو سادہ ترین کسر میں لکھیں۔"
