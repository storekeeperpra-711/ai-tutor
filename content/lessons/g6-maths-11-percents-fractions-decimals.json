  "misconceptions": [
    {
      "id": "one_place",
      "description": "Moves the decimal point one place instead of two (0.6 = 6%, 7% = 0.7)."
    },
    {
      "id": "percent_is_decimal",
      "description": "Writes the percent number as the decimal without dividing by 100 (25% = 25)."
    },
    {
      "id": "not_simplest",
      "description": "Leaves the fraction over 100 or simplifies it wrongly."
    }
  ],
  "mastery_criteria": {
    "maths.percent.convert": {
      "question_types": [
        "recall",
        "apply",
        "find_error"
      ],
      "days": 2
    }
  },
  "question_bank": {
    "maths.percent.convert": [
      {
        "id": "qb_rule",
        "type": "recall",
        "step": {
          "id": "qb_rule",
          "type": "choice",
          "prompt": {
            "en": "How do you change a decimal into a percent?",
            "ur": "اعشاریہ کو فیصد میں کیسے بدلتے ہیں؟"
          },
          "options": [
            {
              "id": "times100",
              "text": {
                "en": "Multiply by 100",
                "ur": "100 سے ضرب دیں"
              },
              "correct": true,
              "feedback": {
                "en": "Yes! 0.3 × 100 = 30, so 0.3 = 30%.",
                "ur": "جی ہاں! 0.3 × 100 = 30، تو 0.3 = 30%"
              }
            },
            {
              "id": "times10",
              "text": {
                "en": "Multiply by 10",
                "ur": "10 سے ضرب دیں"
              },
              "correct": false,
              "feedback": {
                "en": "Percent is out of 100, so multiply by 100.",
                "ur": "فیصد 100 میں سے ہے، تو 100 سے ضرب دیں۔"
              },
              "misconception_id": "one_place"
            },
            {
              "id": "div100",
              "text": {
                "en": "Divide by 100",
                "ur": "100 سے تقسیم کریں"
              },
              "correct": false,
              "feedback": {
                "en": "That goes the other way, from a percent to a decimal.",
                "ur": "یہ الٹا ہے، فیصد سے اعشاریہ۔"
              }
            }
          ]
        }
      },
      {
        "id": "qb_apply",
        "type": "apply",
        "step": {
          "id": "qb_apply",
          "type": "number",
          "prompt": {
            "en": "Write 0.45 as a percent. Type just the number.",
            "ur": "0.45 کو فیصد میں لکھیں۔ صرف عدد لکھیں۔"
          },
          "answer": 45,
          "checker": "numeric",
          "hint": {
            "en": "Multiply by 100.",
            "ur": "100 سے ضرب دیں۔"
          },
          "feedback_correct": {
            "en": "Right! 0.45 = 45%.",
            "ur": "درست! 0.45 = 45%"
          },
          "feedback_wrong": {
            "en": "0.45 × 100 = 45, so 45%.",
            "ur": "0.45 × 100 = 45، یعنی 45%"
          },
          "common_wrong": [
            {
              "answer": 4.5,
              "feedback": {
                "en": "Multiply by 100, not 10: 45%.",
                "ur": "10 نہیں، 100 سے ضرب دیں: 45%"
              },
              "misconception_id": "one_place"
            }
          ]
        }
      },
      {
        "id": "qb_find_error",
        "type": "find_error",
        "step": {
          "id": "qb_find_error",
          "type": "choice",
          "prompt": {
            "en": "Bilal writes 3% as 0.3. What went wrong?",
            "ur": "بلال 3% کو 0.3 لکھتا ہے۔ کیا غلطی ہوئی؟"
          },
          "options": [
            {
              "id": "two",
              "text": {
                "en": "Divide by 100: 3% = 0.03.",
                "ur": "100 سے تقسیم کریں: 3% = 0.03"
              },
              "correct": true,
              "feedback": {
                "en": "Yes! 0.3 would be 30%.",
                "ur": "جی ہاں! 0.3 تو 30% ہوتا۔"
              }
            },
            {
              "id": "nothing",
              "text": {
                "en": "Nothing.",
                "ur": "کوئی غلطی نہیں۔"
              },
              "correct": false,
              "feedback": {
                "en": "0.3 is 3 tenths, which is 30%. 3% is 3 hundredths: 0.03.",
                "ur": "0.3 یعنی 3 دسویں، جو 30% ہے۔ 3% یعنی 3 سوویں: 0.03"
              },
              "misconception_id": "one_place"
            }
          ]
        }
      }
    ]
  },
