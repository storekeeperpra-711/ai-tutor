  "steps": [
    {
      "id": "s1_hook",
      "type": "explain",
      "character": {
        "emotion": "curious",
        "say": {
          "en": "Half a roti, 0.5 of a roti, 50% of a roti. Are these three different amounts, or the same?",
          "ur": "آدھی روٹی، 0.5 روٹی، 50% روٹی۔ کیا یہ تین مختلف مقداریں ہیں یا ایک جیسی؟"
        }
      },
      "text": {
        "en": "Today we change between percents, fractions and decimals. First, a quick check on decimals.",
        "ur": "آج ہم فیصد، کسروں اور اعشاریہ کو ایک دوسرے میں بدلیں گے۔ پہلے اعشاریہ کا ایک چھوٹا سا سوال۔"
      }
    },
    {
      "id": "s2_foundation",
      "type": "number",
      "question_type": "recall",
      "skill": "maths.decimals.place_value",
      "prompt": {
        "en": "How many hundredths are in 0.35?",
        "ur": "0.35 میں کتنے سوویں حصے ہیں؟"
      },
      "answer": 35,
      "checker": "numeric",
      "hint": {
        "en": "0.35 = 3 tenths and 5 hundredths. One tenth is 10 hundredths.",
        "ur": "0.35 = 3 دسویں اور 5 سوویں۔ ایک دسواں 10 سوویں کے برابر ہے۔"
      },
      "feedback_correct": {
        "en": "Right! 0.35 = 35/100.",
        "ur": "درست! 0.35 = 35/100"
      },
      "feedback_wrong": {
        "en": "3 tenths = 30 hundredths, plus 5 more: 35.",
        "ur": "3 دسویں = 30 سوویں، اور 5 مزید: 35"
      },
      "common_wrong": [
        {
          "answer": 5,
          "feedback": {
            "en": "5 is only the hundredths digit. 3 tenths are 30 hundredths more: 35.",
            "ur": "5 صرف سوویں کا ہندسہ ہے۔ 3 دسویں مزید 30 سوویں ہیں: 35"
          }
        }
      ]
    },
    {
      "id": "s3_convert",
      "type": "explain",
      "character": {
        "emotion": "happy",
        "say": {
          "en": "They're all the same amount, just written three ways!",
          "ur": "یہ سب ایک ہی مقدار ہیں، بس تین طریقوں سے لکھی گئی!"
        }
      },
      "text": {
        "en": "A percent is hundredths. Percent to decimal: divide by 100, so the point moves two places left (25% = 0.25, 7% = 0.07). Decimal to percent: multiply by 100 (0.6 = 60%). Percent to fraction: write it over 100 and simplify (40% = 40/100 = 2/5). Fraction to percent: make the bottom 100 (3/4 = 75/100 = 75%).",
        "ur": "فیصد سوویں حصے ہیں۔ فیصد سے اعشاریہ: 100 سے تقسیم کریں، یعنی اعشاریہ دو جگہ بائیں (25% = 0.25، 7% = 0.07)۔ اعشاریہ سے فیصد: 100 سے ضرب دیں (0.6 = 60%)۔ فیصد سے کسر: 100 کے اوپر لکھیں اور سادہ کریں (40% = 40/100 = 2/5)۔ کسر سے فیصد: نیچے والا 100 بنائیں (3/4 = 75/100 = 75%)۔"
      }
    },
    {
      "id": "s4_dec_to_pc",
      "type": "number",
      "question_type": "apply",
      "prompt": {
        "en": "Write 0.6 as a percent. Type just the number.",
        "ur": "0.6 کو فیصد میں لکھیں۔ صرف عدد لکھیں۔"
      },
      "answer": 60,
      "checker": "numeric",
      "hint": {
        "en": "Multiply by 100.",
        "ur": "100 سے ضرب دیں۔"
      },
      "feedback_correct": {
        "en": "Right! 0.6 = 60%.",
        "ur": "درست! 0.6 = 60%"
      },
      "feedback_wrong": {
        "en": "0.6 × 100 = 60, so 60%.",
        "ur": "0.6 × 100 = 60، یعنی 60%"
      },
      "common_wrong": [
        {
          "answer": 6,
          "feedback": {
            "en": "0.6 is 6 tenths, which is 60 hundredths: 60%.",
            "ur": "0.6 یعنی 6 دسویں، جو 60 سوویں ہیں: 60%"
          },
          "misconception_id": "one_place"
        }
      ]
    },
    {
      "id": "s5_pc_to_dec",
      "type": "number",
      "question_type": "apply",
      "prompt": {
        "en": "Write 25% as a decimal.",
        "ur": "25% کو اعشاریہ میں لکھیں۔"
