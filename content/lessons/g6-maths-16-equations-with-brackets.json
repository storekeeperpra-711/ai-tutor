  "question_bank": {
    "maths.equations.brackets": [
      {
        "id": "qb_first",
        "type": "recall",
        "step": {
          "id": "qb_first",
          "type": "choice",
          "prompt": {
            "en": "To solve 4(x + 3) = 20, a good first step is …",
            "ur": "4(x + 3) = 20 حل کرنے کا اچھا پہلا قدم ہے …"
          },
          "options": [
            {
              "id": "divide",
              "text": {
                "en": "divide both sides by 4",
                "ur": "دونوں طرف کو 4 سے تقسیم"
              },
              "correct": true,
              "feedback": {
                "en": "Yes! x + 3 = 5, so x = 2.",
                "ur": "جی ہاں! x + 3 = 5، تو x = 2"
              }
            },
            {
              "id": "subtract3",
              "text": {
                "en": "subtract 3 from both sides",
                "ur": "دونوں طرف سے 3 تفریق"
              },
              "correct": false,
              "feedback": {
                "en": "The 3 is inside the bracket, multiplied by 4. Divide by 4 first.",
                "ur": "3 قوسین کے اندر ہے، 4 سے ضرب ہے۔ پہلے 4 سے تقسیم کریں۔"
              }
            },
            {
              "id": "subtract4",
              "text": {
                "en": "subtract 4 from both sides",
                "ur": "دونوں طرف سے 4 تفریق"
              },
              "correct": false,
              "feedback": {
                "en": "The 4 multiplies the bracket, so undo it by dividing.",
                "ur": "4 قوسین کو ضرب دیتا ہے، تو اسے تقسیم سے ختم کریں۔"
              },
              "misconception_id": "wrong_inverse"
            }
          ]
        }
      },
      {
        "id": "qb_apply",
        "type": "apply",
        "step": {
          "id": "qb_apply",
          "type": "number",
          "prompt": {
            "en": "Solve 7(a + 1) = 42. What is a?",
            "ur": "7(a + 1) = 42 حل کریں۔ a کیا ہے؟"
          },
          "answer": 5,
          "checker": "numeric",
          "hint": {
            "en": "Divide by 7, then subtract 1.",
            "ur": "7 سے تقسیم کریں، پھر 1 تفریق۔"
          },
          "feedback_correct": {
            "en": "Right! a = 5.",
            "ur": "درست! a = 5"
          },
          "feedback_wrong": {
            "en": "42 ÷ 7 = 6, so a + 1 = 6, a = 5.",
            "ur": "42 ÷ 7 = 6، تو a + 1 = 6، a = 5"
          },
          "common_wrong": [
            {
              "answer": 6,
              "feedback": {
                "en": "That is a + 1. Subtract 1: a = 5.",
                "ur": "یہ a + 1 ہے۔ 1 تفریق کریں: a = 5"
              },
              "misconception_id": "stops_at_bracket"
            }
          ]
        }
      },
      {
        "id": "qb_find_error",
        "type": "find_error",
        "step": {
          "id": "qb_find_error",
          "type": "choice",
          "prompt": {
            "en": "Kamran multiplies out 2(x + 4) = 14 as 2x + 4 = 14. What is wrong?",
