  "steps": [
    {
      "id": "s1_hook",
      "type": "explain",
      "character": {
        "emotion": "curious",
        "say": {
          "en": "3 bags, each with x apples and 2 oranges. 21 fruits in all. How many apples in each bag?",
          "ur": "3 تھیلے، ہر ایک میں x سیب اور 2 مالٹے۔ کل 21 پھل۔ ہر تھیلے میں کتنے سیب ہیں؟"
        }
      },
      "text": {
        "en": "That story is 3(x + 2) = 21. Today we solve equations with brackets. First, a quick check on multiplying a bracket.",
        "ur": "یہ کہانی 3(x + 2) = 21 ہے۔ آج ہم قوسین والی مساوات حل کریں گے۔ پہلے قوسین کو ضرب دینے کا ایک چھوٹا سا سوال۔"
      }
    },
    {
      "id": "s2_foundation",
      "type": "number",
      "question_type": "recall",
      "skill": "maths.whole.properties",
      "prompt": {
        "en": "Work out 4 × 6 + 4 × 2, which is the same as 4 × (6 + 2).",
        "ur": "4 × 6 + 4 × 2 نکالیں، جو 4 × (6 + 2) کے برابر ہے۔"
      },
      "answer": 32,
      "checker": "numeric",
      "hint": {
        "en": "24 + 8.",
        "ur": "24 + 8"
      },
      "feedback_correct": {
        "en": "Right! 32.",
        "ur": "درست! 32"
      },
      "feedback_wrong": {
        "en": "4 × 6 = 24, 4 × 2 = 8, 24 + 8 = 32. And 4 × 8 = 32 too.",
        "ur": "4 × 6 = 24، 4 × 2 = 8، 24 + 8 = 32۔ اور 4 × 8 بھی 32 ہے۔"
      },
      "common_wrong": [
        {
          "answer": 26,
          "feedback": {
            "en": "Multiply the 2 by 4 as well: 24 + 8 = 32.",
            "ur": "2 کو بھی 4 سے ضرب دیں: 24 + 8 = 32"
          },
          "misconception_id": "partial_expand"
        }
      ]
    },
    {
      "id": "s3_rule",
      "type": "explain",
      "character": {
        "emotion": "happy",
        "say": {
          "en": "Two ways: divide first, or open the brackets. Both give the same answer!",
          "ur": "دو طریقے: پہلے تقسیم، یا قوسین کھولیں۔ دونوں کا جواب ایک!"
        }
      },
      "text": {
        "en": "Way 1, divide first: 3(x + 2) = 21. Divide both sides by 3: x + 2 = 7. Then x = 5. Way 2, open the brackets: 3(x + 2) = 3x + 6, so 3x + 6 = 21, 3x = 15, x = 5. When you open brackets, multiply EVERY term inside.",
        "ur": "طریقہ 1، پہلے تقسیم: 3(x + 2) = 21۔ دونوں طرف کو 3 سے تقسیم: x + 2 = 7۔ پھر x = 5۔ طریقہ 2، قوسین کھولیں: 3(x + 2) = 3x + 6، تو 3x + 6 = 21، 3x = 15، x = 5۔ قوسین کھولتے وقت اندر کی ہر چیز کو ضرب دیں۔"
      }
    },
    {
      "id": "s4_divide_first",
