        "ur": "3 سے تقسیم کریں، پھر 2 تفریق۔"
      },
      "feedback_correct": {
        "en": "Right! x = 5.",
        "ur": "درست! x = 5"
      },
      "feedback_wrong": {
        "en": "21 ÷ 3 = 7, so x + 2 = 7, x = 5.",
        "ur": "21 ÷ 3 = 7، تو x + 2 = 7، x = 5"
