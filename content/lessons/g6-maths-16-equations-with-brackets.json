          "options": [
            {
              "id": "both",
              "text": {
                "en": "Multiply both terms: 2x + 8 = 14, so x = 3.",
                "ur": "دونوں حصوں کو ضرب دیں: 2x + 8 = 14، تو x = 3"
              },
              "correct": true,
              "feedback": {
                "en": "Yes! The 2 multiplies the 4 too.",
                "ur": "جی ہاں! 2 چار کو بھی ضرب دیتا ہے۔"
              }
            },
            {
              "id": "nothing",
              "text": {
                "en": "Nothing.",
                "ur": "کوئی غلطی نہیں۔"
