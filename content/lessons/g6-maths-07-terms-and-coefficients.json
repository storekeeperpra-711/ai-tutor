      {
        "id": "qb_apply",
        "type": "apply",
        "step": {
          "id": "qb_apply",
          "type": "number",
          "prompt": {
            "en": "What is the coefficient of q in 6p − q + 4?",
            "ur": "6p − q + 4 میں q کا عددی سر کیا ہے؟"
          },
          "answer": -1,
          "checker": "numeric",
          "hint": {
            "en": "−q means −1 × q.",
            "ur": "−q یعنی −1 × q"
          },
          "feedback_correct": {
            "en": "Right! −q is −1q, so the coefficient is −1.",
            "ur": "درست! −q یعنی −1q، تو عددی سر −1 ہے۔"
          },
          "feedback_wrong": {
            "en": "The term is −q = −1q: coefficient −1.",
            "ur": "رکن −q = −1q ہے: عددی سر −1"
          },
          "common_wrong": [
            {
              "answer": 1,
              "feedback": {
                "en": "Keep the minus sign with the term: −q has coefficient −1.",
                "ur": "منفی کی علامت رکن کے ساتھ رکھیں: −q کا عددی سر −1 ہے۔"
              },
              "misconception_id": "drops_sign"
            },
            {
              "answer": 0,
              "feedback": {
                "en": "A letter on its own counts once: −q = −1q.",
                "ur": "اکیلا حرف ایک بار گنا جاتا ہے: −q = −1q"
              },
              "misconception_id": "lone_letter_zero"
            }
          ]
        }
      },
      {
        "id": "qb_find_error",
        "type": "find_error",
        "step": {
          "id": "qb_find_error",
          "type": "choice",
          "prompt": {
            "en": "Usman says 5x − 3 has three terms: 5, x and 3. What is wrong?",
            "ur": "عثمان کہتا ہے 5x − 3 کے تین ارکان ہیں: 5، x اور 3۔ کیا غلطی ہے؟"
          },
          "options": [
            {
              "id": "two_terms",
              "text": {
                "en": "5x is one term. The terms are 5x and −3: two terms.",
                "ur": "5x ایک رکن ہے۔ ارکان 5x اور −3 ہیں: دو ارکان۔"
              },
              "correct": true,
              "feedback": {
                "en": "Yes! Terms are split by + and − signs only.",
                "ur": "جی ہاں! ارکان صرف + اور − سے الگ ہوتے ہیں۔"
              }
            },
            {
              "id": "nothing",
              "text": {
                "en": "Nothing.",
                "ur": "کوئی غلطی نہیں۔"
              },
              "correct": false,
              "feedback": {
                "en": "5x means 5 × x: one term. 5x − 3 has two terms.",
                "ur": "5x یعنی 5 × x: ایک رکن۔ 5x − 3 کے دو ارکان ہیں۔"
              },
              "misconception_id": "splits_terms"
            },
            {
              "id": "one",
              "text": {
                "en": "It has one term.",
                "ur": "اس کا ایک رکن ہے۔"
              },
              "correct": false,
              "feedback": {
                "en": "The − sign splits it into two terms: 5x and −3.",
                "ur": "− کی علامت اسے دو ارکان میں بانٹتی ہے: 5x اور −3"
              }
            }
          ]
        }
      }
    ]
