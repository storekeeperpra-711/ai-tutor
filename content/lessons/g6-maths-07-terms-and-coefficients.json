  "misconceptions": [
    {
      "id": "coefficient_is_constant",
      "description": "Mixes up the coefficient (the number with the letter) and the constant (the number on its own)."
    },
    {
      "id": "lone_letter_zero",
      "description": "Thinks a letter on its own (b) has coefficient 0 instead of 1."
    },
    {
      "id": "drops_sign",
      "description": "Leaves out the minus sign that belongs to a term (−5x has coefficient −5)."
    },
    {
      "id": "splits_terms",
      "description": "Splits a term like 5x into two terms, 5 and x."
    }
  ],
