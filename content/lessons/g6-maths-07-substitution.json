          "guna",
          "zarb"
        ],
        [
          "3 × 4",
          "3 x 4",
          "12"
        ],
        [
          "digit",
          "next to",
          "ہندسہ",
          "ساتھ"
        ]
      ],
      "fallback_feedback": {
        "got_it": {
