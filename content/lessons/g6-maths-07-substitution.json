        },
        "partly": {
          "en": "Good start! Now say why 34 is wrong: what does the 3 next to n mean?",
          "ur": "اچھی شروعات! اب بتائیں 34 کیوں غلط ہے: n کے ساتھ 3 کا کیا مطلب ہے؟"
        },
        "not_yet": {
          "en": "Remember: 3n is short for 3 × n. What is 3 × 4?",
          "ur": "یاد کریں: 3n مختصر ہے 3 × n کا۔ 3 × 4 کتنا ہے؟"
        }
      },
      "limit_per_day": 3,
      "max_attempts": 2
    },
    {
      "id": "s11_take_away",
      "type": "number",
      "question_type": "apply",
      "prompt": {
        "en": "Find the value of 10 − 2k when k = 3.",
        "ur": "جب k = 3 ہو تو 10 − 2k کی قیمت معلوم کریں۔"
      },
      "answer": 4,
      "checker": "numeric",
      "hint": {
        "en": "Work out 2k = 2 × 3 first.",
        "ur": "پہلے 2k = 2 × 3 نکالیں۔"
      },
      "feedback_correct": {
        "en": "Right! 10 − 6 = 4.",
        "ur": "درست! 10 − 6 = 4"
      },
      "feedback_wrong": {
        "en": "2 × 3 = 6, then 10 − 6 = 4.",
        "ur": "2 × 3 = 6، پھر 10 − 6 = 4"
      },
      "common_wrong": [
        {
          "answer": 24,
          "feedback": {
            "en": "Multiply first: 2 × 3 = 6, then 10 − 6 = 4.",
