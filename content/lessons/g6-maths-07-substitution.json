  "question_bank": {
    "maths.algebra.substitution": [
      {
        "id": "qb_recall",
        "type": "recall",
        "step": {
          "id": "qb_recall",
          "type": "choice",
          "prompt": {
            "en": "If m = 5, what is 4m?",
            "ur": "اگر m = 5 ہو تو 4m کتنا ہے؟"
          },
          "options": [
            {
              "id": "twenty",
              "text": {
                "en": "20",
                "ur": "20"
              },
              "correct": true,
              "feedback": {
                "en": "Yes! 4m means 4 × m = 4 × 5 = 20.",
                "ur": "جی ہاں! 4m یعنی 4 × m = 4 × 5 = 20"
              }
            },
            {
              "id": "fortyfive",
              "text": {
                "en": "45",
                "ur": "45"
              },
              "correct": false,
              "feedback": {
                "en": "m is not a digit. 4m means 4 × 5 = 20.",
                "ur": "m ہندسہ نہیں۔ 4m یعنی 4 × 5 = 20"
              },
              "misconception_id": "letter_is_digit"
            },
            {
              "id": "nine",
              "text": {
                "en": "9",
                "ur": "9"
              },
              "correct": false,
              "feedback": {
                "en": "That is 4 + 5. 4m means 4 × 5 = 20.",
                "ur": "یہ 4 + 5 ہے۔ 4m یعنی 4 × 5 = 20"
              }
            }
          ]
        }
      },
      {
        "id": "qb_apply",
        "type": "apply",
        "step": {
          "id": "qb_apply",
          "type": "number",
          "prompt": {
            "en": "Find the value of 6 + 2c when c = 7.",
            "ur": "جب c = 7 ہو تو 6 + 2c کی قیمت معلوم کریں۔"
          },
          "answer": 20,
          "checker": "numeric",
          "hint": {
            "en": "Work out 2c first: 2 × 7.",
            "ur": "پہلے 2c نکالیں: 2 × 7"
          },
          "feedback_correct": {
            "en": "Right! 6 + 14 = 20.",
            "ur": "درست! 6 + 14 = 20"
          },
          "feedback_wrong": {
            "en": "2c = 2 × 7 = 14, then 6 + 14 = 20.",
            "ur": "2c = 2 × 7 = 14، پھر 6 + 14 = 20"
          },
          "common_wrong": [
            {
              "answer": 56,
              "feedback": {
                "en": "Multiply before adding: 2 × 7 = 14, then 6 + 14 = 20.",
                "ur": "جمع سے پہلے ضرب: 2 × 7 = 14، پھر 6 + 14 = 20"
              },
              "misconception_id": "adds_first"
            },
            {
              "answer": 33,
              "feedback": {
                "en": "c is not a digit: 2c = 2 × 7 = 14, so 6 + 14 = 20.",
                "ur": "c ہندسہ نہیں: 2c = 2 × 7 = 14، تو 6 + 14 = 20"
              },
              "misconception_id": "letter_is_digit"
            }
          ]
        }
      },
      {
        "id": "qb_find_error",
        "type": "find_error",
        "step": {
          "id": "qb_find_error",
          "type": "choice",
          "prompt": {
            "en": "Asma says 2a + 1 = 8 when a = 3, because 3 + 1 = 4 and 2 × 4 = 8. What went wrong?",
            "ur": "اسماء کہتی ہے a = 3 پر 2a + 1 = 8، کیونکہ 3 + 1 = 4 اور 2 × 4 = 8۔ کیا غلطی ہوئی؟"
          },
          "options": [
            {
              "id": "order",
              "text": {
                "en": "She added first. Multiply first: 2 × 3 = 6, then 6 + 1 = 7.",
                "ur": "اس نے پہلے جمع کیا۔ پہلے ضرب: 2 × 3 = 6، پھر 6 + 1 = 7"
              },
              "correct": true,
              "feedback": {
                "en": "Yes! 2a means 2 × a, worked out before the + 1.",
                "ur": "جی ہاں! 2a یعنی 2 × a، جو + 1 سے پہلے نکالتے ہیں۔"
              }
            },
            {
              "id": "nothing",
              "text": {
                "en": "Nothing.",
                "ur": "کوئی غلطی نہیں۔"
              },
              "correct": false,
              "feedback": {
                "en": "2a + 1 means (2 × a) + 1 = 6 + 1 = 7.",
                "ur": "2a + 1 یعنی (2 × a) + 1 = 6 + 1 = 7"
              },
              "misconception_id": "adds_first"
            }
          ]
        }
      }
    ]
  },
  "flashcards": [
    {
      "id": "f_sub",
      "front": {
        "en": "How do you substitute?",
        "ur": "قیمت کیسے رکھتے ہیں؟"
      },
      "back": {
        "en": "Put the number in place of the letter, then work it out. 3n + 2 with n = 4: 3 × 4 + 2 = 14.",
        "ur": "حرف کی جگہ عدد رکھیں، پھر حل کریں۔ n = 4 پر 3n + 2: 3 × 4 + 2 = 14"
      }
    },
    {
      "id": "f_order",
      "front": {
        "en": "3n + 2: which first?",
        "ur": "3n + 2: پہلے کیا؟"
      },
      "back": {
        "en": "Multiply first (3 × n), then add 2.",
        "ur": "پہلے ضرب (3 × n)، پھر 2 جمع۔"
      }
    }
  ],
  "home_tasks": [
    {
      "id": "h_fare",
      "text": {
        "en": "A rickshaw charges 50 rupees plus 20 rupees for each km: 50 + 20k. Work out the fare for 2 km, 5 km and 10 km. Which trips around your home would cost what?",
        "ur": "رکشہ 50 روپے اور ہر کلومیٹر کے 20 روپے لیتا ہے: 50 + 20k۔ 2، 5 اور 10 کلومیٹر کا کرایہ نکالیں۔ آپ کے گھر کے آس پاس کون سا سفر کتنے کا ہوگا؟"
      }
    }
  ],
  "glossary": [
    {
      "en": "Substitute",
      "ur": "قیمت رکھنا"
    },
    {
      "en": "Value of an expression",
      "ur": "عبارت کی قیمت"
    }
  ],
  "steps": [
    {
      "id": "s1_hook",
      "type": "explain",
      "character": {
        "emotion": "curious",
        "say": {
          "en": "A square's perimeter is 4s, where s is its side. What if the side is 9 cm? Let's find out!",
          "ur": "مربع کا احاطہ 4s ہے، جہاں s اس کا ضلع ہے۔ اگر ضلع 9 سینٹی میٹر ہو تو؟ آئیں معلوم کریں!"
        }
      },
      "text": {
        "en": "When we know the number a letter stands for, we can find the value of the expression. First, a quick check.",
        "ur": "جب معلوم ہو کہ حرف کس عدد کی جگہ ہے تو ہم عبارت کی قیمت نکال سکتے ہیں۔ پہلے ایک چھوٹا سا سوال۔"
      }
    },
    {
      "id": "s2_foundation",
      "type": "text_check",
      "question_type": "recall",
      "skill": "maths.algebra.variables",
      "prompt": {
        "en": "Write an expression for '7 more than t'.",
        "ur": "'t سے 7 زیادہ' کی عبارت لکھیں۔"
      },
      "checker": "text",
      "expected": "t + 7",
      "accept": [
        "7 + t"
      ],
      "hint": {
        "en": "More than means add.",
        "ur": "زیادہ کا مطلب جمع۔"
      },
      "feedback_correct": {
        "en": "Right! t + 7.",
        "ur": "درست! t + 7"
      },
      "feedback_wrong": {
        "en": "7 more than t is t + 7.",
        "ur": "t سے 7 زیادہ یعنی t + 7"
      },
      "common_wrong": [
        {
          "answer": "7t",
          "feedback": {
            "en": "7t means 7 × t. More than means add: t + 7.",
            "ur": "7t یعنی 7 × t۔ زیادہ کا مطلب جمع: t + 7"
          }
        }
      ]
    },
    {
      "id": "s3_how",
      "type": "explain",
      "character": {
        "emotion": "happy",
        "say": {
          "en": "Swap the letter for its number, then work it out!",
          "ur": "حرف کی جگہ اس کا عدد رکھیں، پھر حل کریں!"
        }
      },
      "text": {
        "en": "This is called substitution. Remember 3n means 3 × n. So when n = 4, 3n + 2 = 3 × 4 + 2 = 12 + 2 = 14. Multiply first, then add or take away.",
        "ur": "اسے قیمت رکھنا کہتے ہیں۔ یاد رکھیں 3n یعنی 3 × n۔ تو جب n = 4 ہو، 3n + 2 = 3 × 4 + 2 = 12 + 2 = 14۔ پہلے ضرب، پھر جمع یا تفریق۔"
      }
    },
    {
      "id": "s4_add",
      "type": "number",
      "question_type": "apply",
      "prompt": {
        "en": "Find the value of x + 9 when x = 6.",
        "ur": "جب x = 6 ہو تو x + 9 کی قیمت معلوم کریں۔"
      },
      "answer": 15,
      "checker": "numeric",
      "hint": {
        "en": "Put 6 in place of x.",
        "ur": "x کی جگہ 6 رکھیں۔"
      },
      "feedback_correct": {
        "en": "Right! 6 + 9 = 15.",
        "ur": "درست! 6 + 9 = 15"
      },
      "feedback_wrong": {
        "en": "x + 9 = 6 + 9 = 15.",
        "ur": "x + 9 = 6 + 9 = 15"
      },
      "common_wrong": [
        {
          "answer": 54,
          "feedback": {
            "en": "That is 6 × 9. x + 9 means add: 15.",
            "ur": "یہ 6 × 9 ہے۔ x + 9 میں جمع: 15"
          }
        }
      ]
    },
    {
      "id": "s5_times_add",
      "type": "number",
      "question_type": "apply",
      "prompt": {
        "en": "Find the value of 3n + 2 when n = 4.",
        "ur": "جب n = 4 ہو تو 3n + 2 کی قیمت معلوم کریں۔"
      },
      "answer": 14,
      "checker": "numeric",
      "hint": {
        "en": "3n means 3 × 4. Do that first.",
        "ur": "3n یعنی 3 × 4۔ پہلے یہ کریں۔"
      },
      "feedback_correct": {
        "en": "Right! 12 + 2 = 14.",
        "ur": "درست! 12 + 2 = 14"
      },
      "feedback_wrong": {
        "en": "3 × 4 = 12, then 12 + 2 = 14.",
        "ur": "3 × 4 = 12، پھر 12 + 2 = 14"
      },
      "common_wrong": [
        {
          "answer": 36,
          "feedback": {
            "en": "3n is 3 × n, not 34. 3 × 4 + 2 = 14.",
            "ur": "3n یعنی 3 × n، نہ کہ 34۔ 3 × 4 + 2 = 14"
          },
          "misconception_id": "letter_is_digit"
        },
        {
          "answer": 18,
          "feedback": {
            "en": "Multiply before adding: 3 × 4 = 12, then + 2 = 14.",
            "ur": "جمع سے پہلے ضرب: 3 × 4 = 12، پھر + 2 = 14"
          },
          "misconception_id": "adds_first"
        }
      ]
    },
    {
      "id": "s6_times_subtract",
      "type": "number",
      "question_type": "apply",
      "prompt": {
        "en": "Find the value of 5a − 3 when a = 2.",
        "ur": "جب a = 2 ہو تو 5a − 3 کی قیمت معلوم کریں۔"
      },
      "answer": 7,
      "checker": "numeric",
      "hint": {
        "en": "5 × 2 first, then take away 3.",
        "ur": "پہلے 5 × 2، پھر 3 گھٹائیں۔"
      },
      "feedback_correct": {
        "en": "Right! 10 − 3 = 7.",
        "ur": "درست! 10 − 3 = 7"
      },
      "feedback_wrong": {
        "en": "5 × 2 = 10, then 10 − 3 = 7.",
        "ur": "5 × 2 = 10، پھر 10 − 3 = 7"
      },
      "common_wrong": [
        {
          "answer": 49,
          "feedback": {
            "en": "5a is 5 × a, not 52. 5 × 2 − 3 = 7.",
            "ur": "5a یعنی 5 × a، نہ کہ 52۔ 5 × 2 − 3 = 7"
          },
          "misconception_id": "letter_is_digit"
        },
        {
          "answer": 10,
          "feedback": {
            "en": "That is 5a. Now take away 3: 7.",
            "ur": "یہ 5a ہے۔ اب 3 گھٹائیں: 7"
          }
        }
      ]
    },
    {
      "id": "s7_two_letters",
      "type": "number",
      "question_type": "apply",
      "prompt": {
        "en": "Find the value of 2a + b when a = 3 and b = 4.",
        "ur": "جب a = 3 اور b = 4 ہو تو 2a + b کی قیمت معلوم کریں۔"
      },
      "answer": 10,
      "checker": "numeric",
      "hint": {
        "en": "2a = 2 × 3. Then add b.",
        "ur": "2a = 2 × 3۔ پھر b جمع کریں۔"
      },
      "feedback_correct": {
        "en": "Right! 6 + 4 = 10.",
        "ur": "درست! 6 + 4 = 10"
      },
      "feedback_wrong": {
        "en": "2 × 3 = 6, then 6 + 4 = 10.",
        "ur": "2 × 3 = 6، پھر 6 + 4 = 10"
      },
      "common_wrong": [
        {
          "answer": 14,
          "feedback": {
            "en": "Only a is doubled: 2 × 3 + 4 = 10.",
            "ur": "صرف a دگنا ہوتا ہے: 2 × 3 + 4 = 10"
          },
          "misconception_id": "adds_first"
        },
        {
          "answer": 27,
          "feedback": {
            "en": "2a is 2 × a, not 23. 6 + 4 = 10.",
            "ur": "2a یعنی 2 × a، نہ کہ 23۔ 6 + 4 = 10"
          },
          "misconception_id": "letter_is_digit"
        }
      ]
    },
    {
      "id": "s8_square",
      "type": "number",
      "question_type": "apply",
      "prompt": {
        "en": "Back to the square: its perimeter is 4s. Find the perimeter when s = 9 cm.",
        "ur": "واپس مربع پر: اس کا احاطہ 4s ہے۔ جب s = 9 سینٹی میٹر ہو تو احاطہ معلوم کریں۔"
      },
      "answer": 36,
      "checker": "numeric",
      "hint": {
        "en": "4s means 4 × 9.",
        "ur": "4s یعنی 4 × 9"
      },
      "feedback_correct": {
        "en": "Right! 36 cm.",
        "ur": "درست! 36 سینٹی میٹر"
      },
      "feedback_wrong": {
        "en": "4 × 9 = 36 cm: four sides of 9 cm.",
        "ur": "4 × 9 = 36 سینٹی میٹر: 9 سینٹی میٹر کے چار ضلعے۔"
      },
      "common_wrong": [
        {
          "answer": 13,
          "feedback": {
            "en": "That is 4 + 9. A square has 4 sides of 9: 4 × 9 = 36.",
            "ur": "یہ 4 + 9 ہے۔ مربع کے 9 کے 4 ضلعے: 4 × 9 = 36"
          }
        },
        {
          "answer": 49,
          "feedback": {
            "en": "4s is 4 × s, not 49. 4 × 9 = 36.",
            "ur": "4s یعنی 4 × s، نہ کہ 49۔ 4 × 9 = 36"
          },
          "misconception_id": "letter_is_digit"
        }
      ]
    },
    {
      "id": "s9_find_error",
      "type": "choice",
      "question_type": "find_error",
      "prompt": {
        "en": "Zara says that when y = 5, 2y = 25. What went wrong?",
        "ur": "زارا کہتی ہے جب y = 5 ہو تو 2y = 25۔ کیا غلطی ہوئی؟"
      },
      "options": [
        {
          "id": "digit",
          "text": {
            "en": "2y means 2 × y = 10, not the digits 2 and 5.",
            "ur": "2y یعنی 2 × y = 10، نہ کہ ہندسے 2 اور 5"
          },
          "correct": true,
          "feedback": {
            "en": "Yes! A number next to a letter means multiply.",
            "ur": "جی ہاں! حرف کے ساتھ لکھا عدد ضرب کا مطلب دیتا ہے۔"
          }
        },
        {
          "id": "seven",
          "text": {
            "en": "It should be 7.",
            "ur": "یہ 7 ہونا چاہیے۔"
          },
          "correct": false,
          "feedback": {
            "en": "7 is 2 + 5. 2y means 2 × 5 = 10.",
            "ur": "7 یعنی 2 + 5۔ 2y یعنی 2 × 5 = 10"
          }
        },
        {
          "id": "nothing",
          "text": {
            "en": "Nothing.",
            "ur": "کوئی غلطی نہیں۔"
          },
          "correct": false,
          "feedback": {
            "en": "2y is 2 × y. With y = 5 that is 10.",
            "ur": "2y یعنی 2 × y۔ y = 5 پر یہ 10 ہے۔"
          },
          "misconception_id": "letter_is_digit"
        }
      ]
    },
    {
