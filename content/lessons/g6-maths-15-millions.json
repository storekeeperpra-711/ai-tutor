      "answer": 100,
      "checker": "numeric",
      "hint": {
        "en": "1,00,000 ÷ 1000.",
        "ur": "1,00,000 ÷ 1000"
      },
      "feedback_correct": {
        "en": "Right! 100 thousand.",
        "ur": "درست! 100 ہزار"
      },
      "feedback_wrong": {
        "en": "1,00,000 ÷ 1000 = 100.",
        "ur": "1,00,000 ÷ 1000 = 100"
