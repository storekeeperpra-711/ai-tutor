  "misconceptions": [
    {
      "id": "two_sides_only",
      "description": "Adds only the two sides given (length + width) instead of all four."
    },
    {
      "id": "area_for_perimeter",
      "description": "Multiplies length by width (the area) when the perimeter is asked."
    },
    {
      "id": "missing_side_subtract",
      "description": "Finds a missing side by taking one side from the whole perimeter, forgetting there are two of each."
    }
