    {
      "id": "s10_explain_why",
      "type": "ai_explain",
      "question_type": "explain",
      "task_kind": "explain",
      "character": {
        "emotion": "curious",
        "say": {
          "en": "Why does everyone need to follow the same order? Can you teach me?",
          "ur": "سب کو ایک ہی ترتیب کیوں ماننی چاہیے؟ کیا آپ مجھے سکھا سکتے ہیں؟"
        }
      },
      "task": {
        "en": "In your own words: why do we all agree to do × and ÷ before + and −?",
        "ur": "اپنے الفاظ میں بتائیں: ہم سب × اور ÷ کو + اور − سے پہلے کرنے پر کیوں متفق ہیں؟"
      },
      "key_idea": "If people worked in different orders, the same sum would give different answers (3 + 4 × 5 could be 23 or 35). One agreed order means everyone gets the same answer.",
      "levels": {
        "got_it": "Says without one agreed order, the same sum could give different answers, so everyone follows one rule to get the same answer.",
