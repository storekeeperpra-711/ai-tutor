      "back": {
        "en": "× and ÷ first, then + and −.",
        "ur": "پہلے × اور ÷، پھر + اور −۔"
      }
    },
    {
      "id": "f_same",
      "front": {
        "en": "Two of the same level, like − and +?",
        "ur": "ایک ہی درجے کے دو، جیسے − اور +؟"
      },
      "back": {
        "en": "Work from left to right.",
        "ur": "بائیں سے دائیں حل کریں۔"
      }
    }
  ],
  "home_tasks": [
