    }
  ],
  "skills": [
    "maths.simplify.order_of_operations"
  ],
  "title": {
    "en": "Order of operations",
    "ur": "عملیات کی ترتیب"
  },
  "estimated_minutes": 12,
  "prerequisites": [
    {
      "skill": "maths.integers.multiply_divide"
    }
  ],
  "misconceptions": [
    {
      "id": "left_to_right_all",
      "description": "Works strictly from left to right, doing + or − before × or ÷."
    },
    {
      "id": "add_before_subtract",
      "description": "Always adds before subtracting (or multiplies before dividing) instead of going left to right."
    }
  ],
  "mastery_criteria": {
    "maths.simplify.order_of_operations": {
      "question_types": [
        "recall",
        "apply",
        "find_error"
      ],
      "days": 2
    }
  },
  "question_bank": {
    "maths.simplify.order_of_operations": [
      {
        "id": "qb_rule",
        "type": "recall",
        "step": {
          "id": "qb_rule",
          "type": "choice",
          "prompt": {
            "en": "In 9 − 3 × 2, what do you do first?",
            "ur": "9 − 3 × 2 میں پہلے کیا کرتے ہیں؟"
          },
          "options": [
            {
              "id": "times",
              "text": {
                "en": "3 × 2",
                "ur": "3 × 2"
              },
              "correct": true,
              "feedback": {
                "en": "Yes! × and ÷ come before + and −. 9 − 6 = 3.",
                "ur": "جی ہاں! × اور ÷ پہلے، + اور − بعد میں۔ 9 − 6 = 3"
              }
            },
            {
              "id": "minus",
              "text": {
                "en": "9 − 3",
                "ur": "9 − 3"
              },
              "correct": false,
              "feedback": {
                "en": "Multiplication comes before subtraction.",
                "ur": "ضرب تفریق سے پہلے آتی ہے۔"
              },
              "misconception_id": "left_to_right_all"
            }
          ]
        }
      },
      {
        "id": "qb_apply",
        "type": "apply",
        "step": {
          "id": "qb_apply",
          "type": "number",
          "prompt": {
            "en": "Simplify: 7 + 2 × 6",
            "ur": "مختصر کریں: 7 + 2 × 6"
          },
          "answer": 19,
          "checker": "numeric",
          "hint": {
            "en": "Do 2 × 6 first.",
            "ur": "پہلے 2 × 6 کریں۔"
          },
          "feedback_correct": {
            "en": "Right! 7 + 12 = 19.",
            "ur": "درست! 7 + 12 = 19"
          },
          "feedback_wrong": {
            "en": "2 × 6 = 12, then 7 + 12 = 19.",
            "ur": "2 × 6 = 12، پھر 7 + 12 = 19"
          },
          "common_wrong": [
            {
              "answer": 54,
              "feedback": {
                "en": "That adds first. Multiply first: 7 + 12 = 19.",
                "ur": "یہ پہلے جمع ہے۔ پہلے ضرب: 7 + 12 = 19"
              },
              "misconception_id": "left_to_right_all"
            }
          ]
        }
      },
      {
        "id": "qb_find_error",
        "type": "find_error",
        "step": {
          "id": "qb_find_error",
          "type": "choice",
          "prompt": {
            "en": "Hamza works out 10 − 4 ÷ 2 = 6 ÷ 2 = 3. What is wrong?",
            "ur": "حمزہ 10 − 4 ÷ 2 = 6 ÷ 2 = 3 نکالتا ہے۔ کیا غلطی ہے؟"
          },
          "options": [
            {
              "id": "divide",
              "text": {
                "en": "He should divide first: 4 ÷ 2 = 2, so 10 − 2 = 8.",
                "ur": "اسے پہلے تقسیم کرنی چاہیے: 4 ÷ 2 = 2، تو 10 − 2 = 8"
              },
              "correct": true,
              "feedback": {
                "en": "Yes! ÷ comes before −.",
                "ur": "جی ہاں! ÷، − سے پہلے آتا ہے۔"
              }
            },
            {
              "id": "nothing",
              "text": {
                "en": "Nothing.",
                "ur": "کوئی غلطی نہیں۔"
              },
              "correct": false,
              "feedback": {
                "en": "He subtracted first. Divide first: 10 − 2 = 8.",
                "ur": "اس نے پہلے تفریق کی۔ پہلے تقسیم: 10 − 2 = 8"
              },
              "misconception_id": "left_to_right_all"
            }
          ]
        }
      }
    ]
  },
  "flashcards": [
    {
      "id": "f_order",
      "front": {
        "en": "Which first: × ÷ or + −?",
        "ur": "پہلے کون: × ÷ یا + −؟"
