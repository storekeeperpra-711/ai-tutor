      },
      "feedback_correct": {
        "en": "Right! 20 + 5 = 25.",
        "ur": "درست! 20 + 5 = 25"
      },
      "feedback_wrong": {
        "en": "30 − 10 = 20, then 20 + 5 = 25.",
