  "steps": [
    {
      "id": "s1_hook",
      "type": "explain",
      "character": {
        "emotion": "curious",
        "say": {
          "en": "Aisha says 3 + 4 × 5 is 35. Bilal says 23. Who is right?",
          "ur": "عائشہ کہتی ہے 3 + 4 × 5 کا جواب 35 ہے۔ بلال کہتا ہے 23۔ کون درست ہے؟"
        }
      },
      "text": {
        "en": "Today we learn the order to do + − × ÷ in. First, a quick check.",
        "ur": "آج ہم سیکھیں گے کہ + − × ÷ کس ترتیب سے کرتے ہیں۔ پہلے ایک چھوٹا سا سوال۔"
      }
    },
    {
      "id": "s2_foundation",
      "type": "number",
      "question_type": "recall",
      "skill": "maths.integers.multiply_divide",
      "prompt": {
        "en": "(−4) × 5 = ?",
        "ur": "(−4) × 5 = ?"
      },
      "answer": -20,
      "checker": "numeric",
      "hint": {
        "en": "A negative times a positive is negative.",
        "ur": "منفی ضرب مثبت، منفی ہوتا ہے۔"
      },
      "feedback_correct": {
        "en": "Right! −20.",
        "ur": "درست! −20"
      },
      "feedback_wrong": {
        "en": "4 × 5 = 20, and the sign is negative: −20.",
        "ur": "4 × 5 = 20، اور علامت منفی ہے: −20"
      },
      "common_wrong": [
        {
          "answer": 20,
          "feedback": {
            "en": "Keep the sign: negative × positive = negative, −20.",
            "ur": "علامت رکھیں: منفی × مثبت = منفی، −20"
          }
        }
      ]
    },
    {
      "id": "s3_rule",
      "type": "explain",
      "character": {
        "emotion": "happy",
        "say": {
          "en": "Times and divide first. Then add and take away. Same level? Left to right!",
          "ur": "ضرب اور تقسیم پہلے۔ پھر جمع اور تفریق۔ ایک ہی درجہ؟ بائیں سے دائیں!"
        }
      },
      "text": {
        "en": "Everyone agrees on one order so that a sum has only one answer. 1) Do × and ÷, going from left to right. 2) Then do + and −, going from left to right. So 3 + 4 × 5 = 3 + 20 = 23. Bilal is right.",
        "ur": "سب ایک ہی ترتیب مانتے ہیں تاکہ سوال کا ایک ہی جواب ہو۔ 1) × اور ÷ کریں، بائیں سے دائیں۔ 2) پھر + اور − کریں، بائیں سے دائیں۔ تو 3 + 4 × 5 = 3 + 20 = 23۔ بلال درست ہے۔"
      }
    },
    {
      "id": "s4_times_first",
      "type": "number",
      "question_type": "apply",
      "prompt": {
        "en": "Simplify: 3 + 4 × 5",
        "ur": "مختصر کریں: 3 + 4 × 5"
      },
      "answer": 23,
      "checker": "numeric",
      "hint": {
        "en": "Do 4 × 5 first.",
        "ur": "پہلے 4 × 5 کریں۔"
      },
      "feedback_correct": {
        "en": "Right! 3 + 20 = 23.",
        "ur": "درست! 3 + 20 = 23"
      },
      "feedback_wrong": {
        "en": "4 × 5 = 20, then 3 + 20 = 23.",
        "ur": "4 × 5 = 20، پھر 3 + 20 = 23"
      },
      "common_wrong": [
        {
          "answer": 35,
          "feedback": {
            "en": "That adds first. Multiply first: 3 + 20 = 23.",
            "ur": "یہ پہلے جمع ہے۔ پہلے ضرب: 3 + 20 = 23"
          },
          "misconception_id": "left_to_right_all"
        }
      ]
    },
    {
      "id": "s5_divide_first",
      "type": "number",
      "question_type": "apply",
      "prompt": {
